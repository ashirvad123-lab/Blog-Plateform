# ==============================================================================
# BlogSphere - Environment Configuration Example
# Copy this file to .env and adjust variables as needed for your environment.
# ==============================================================================

# Flask Environment: 'development', 'production', or 'testing'
FLASK_ENV=development

# Application Secret Key (Must be set to a cryptographically secure string in production)
# Generate one using: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace-with-a-cryptographically-secure-random-key-in-production

# Database Connection URI
# SQLite (Default):
DATABASE_URL=sqlite:///instance/blog.db

# PostgreSQL (Example for Production on Render / Heroku):
# DATABASE_URL=postgresql://user:password@host:5432/blogsphere_db

# CSRF Protection Secret Key
WTF_CSRF_SECRET_KEY=replace-with-another-secure-csrf-token
